# Discord Bot Configuration
# Bot token from Discord Developer Portal (required)
# Get it from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_token_here

# Google AI API Configuration
# Google AI API key for Gemini (required)
# Get it from: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your_key_here

# Bot Settings
# Command prefix for legacy commands (optional, default: !)
BOT_PREFIX=!

# Logging Configuration
# Logging verbosity level (optional, default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Rate Limiting Configuration (optional)
# Any rate limiting or configuration variables
RATE_LIMIT=100

# Troubleshooting
# If bot doesn't start:
# - Verify DISCORD_BOT_TOKEN is valid from Discord Developer Portal
# - Check GOOGLE_AI_API_KEY is active and not rate-limited
# - Ensure LOG_LEVEL is one of the valid options above
# - Check firewall/network allows Discord API connections